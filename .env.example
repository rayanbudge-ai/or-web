# Copier en `.env` et renseigner avec les vraies valeurs (jamais commiter .env)
PORT=3000

# SMTP OVH
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=contact@or-web.fr
SMTP_PASS=__mot_de_passe_smtp__

# Adresse qui reçoit les leads du formulaire de contact
NOTIFICATION_EMAIL=contact@or-web.fr

# ── Mesure d'audience (suivi sans cookie) ──────────────────────────────────
# Les deux doivent être présentes, sinon la mesure reste inactive et le site
# fonctionne normalement (un avertissement est logué au démarrage).
# Pas de sel à configurer : la clé du hash visiteur est tirée chaque jour en
# mémoire et jetée ensuite (voir server.js).

# API du CRM, qui stocke les visites.
CRM_API_URL=https://api.crm.or-web.fr
# Clé d'ingestion. Doit valoir MESURE_API_KEY côté CRM, et différer de sa
# clé machine API_KEY. openssl rand -hex 32
MESURE_API_KEY=__cle_de_mesure__
